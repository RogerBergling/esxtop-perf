# Optional overrides. Defaults are shown.
ESXTOP_MAX_UPLOAD_MB=512
ESXTOP_MAX_DECOMPRESSED_MB=1536
ESXTOP_MAX_CELLS=20000000
ESXTOP_MAX_SERIES=200000
ESXTOP_MAX_ROWS=50000
ESXTOP_SESSION_TTL_MINUTES=30
ESXTOP_MAX_SESSIONS=4
ESXTOP_MAX_CONCURRENT_ANALYSES=1
ESXTOP_MAX_CONCURRENT_REQUESTS=32
ESXTOP_REQUEST_TIMEOUT_SECONDS=120
# ESXTOP_MAX_REQUEST_SERIES=200
# ESXTOP_MAX_REQUEST_CELLS=5000000
# Optional upload password. Leave empty for a private/local instance.
# When set, /api/analyze requires the password entered in the import page.
# Use a long random value for any internet-facing deployment.
ESXTOP_UPLOAD_PASSWORD=

# ESXTOP_SESSION_DIR=/tmp/esxtop-lens-sessions
